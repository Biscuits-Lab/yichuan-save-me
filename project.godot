; 毅川救我 — dungeon roguelite and side-view sandbox survival
config_version=5

[application]
config/name="毅川救我"
config/version="0.5.1"
config/description="地牢救援与 2D 沙盒双模式。神父每 5 个游戏日到访；通过高难 Code Review，免费任选一件物资。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)

[physics]
common/physics_interpolation=true

[audio]
driver/enable_input=false

[debug]
file_logging/enable_file_logging=false
